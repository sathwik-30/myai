# Medha model configuration
# Keep real secrets in .env or the operating-system environment. Never commit them.

# Optional cloud brain
MEDHA_MODEL_PROVIDER=openai
MEDHA_OPENAI_API_KEY=
MEDHA_CLOUD_MODEL=gpt-5.6-sol
MEDHA_LLM_TIMEOUT=60

# Future local provider
# MEDHA_LOCAL_MODEL=

# Optional local conversational model
MEDHA_OLLAMA_URL=http://127.0.0.1:11434
MEDHA_OLLAMA_MODEL=llama3.2:3b
MEDHA_OLLAMA_TIMEOUT=30
